# Writes re_commit.h (#define RE_COMMIT "<short hash>[-modificado]") for the crash and bug reports. Runs on
# every build (target tlender_commit) and rewrites the file only when the commit changes: nothing recompiles otherwise.
#   cmake -DGIT=<git> -DSRC=<repository> -DOUT=<header> -P gen_commit.cmake
set(commit "desconhecido")
if(GIT)
    execute_process(COMMAND "${GIT}" rev-parse --short=7 HEAD WORKING_DIRECTORY "${SRC}"
                    OUTPUT_VARIABLE hash OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET RESULT_VARIABLE r)
    if(r EQUAL 0 AND hash)
        set(commit "${hash}")
        execute_process(COMMAND "${GIT}" status --porcelain --untracked-files=no WORKING_DIRECTORY "${SRC}"
                        OUTPUT_VARIABLE dirty OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
        if(dirty)
            set(commit "${hash}-modificado")
        endif()
    endif()
endif()
set(content "// Generated by tools/gen_commit.cmake\n#define RE_COMMIT \"${commit}\"\n")
set(old "")
if(EXISTS "${OUT}")
    file(READ "${OUT}" old)
endif()
if(NOT old STREQUAL content)
    file(WRITE "${OUT}" "${content}")
endif()
