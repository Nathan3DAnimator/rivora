# The demos' CC0 assets (data/demo/manifest.tsv: Poly Haven models, ambientCG textures; LICENSES.txt) into OUT
# (DemoContent next to the executables). Run every build: a file already there with its size is skipped, so after the
# first build it costs nothing. Without internet the demos keep their simple materials (a warning, never a failure).
#   cmake -DMANIFEST=data/demo/manifest.tsv -DLICENSES=data/demo/LICENSES.txt -DOUT=<dir> -DCACHE=<dir> -P fetch_demo_assets.cmake
file(STRINGS "${MANIFEST}" lines)
file(MAKE_DIRECTORY "${OUT}" "${CACHE}")
configure_file("${LICENSES}" "${OUT}/LICENSES.txt" COPYONLY)
set(failed 0)
set(got 0)
foreach(line IN LISTS lines)
    if(line MATCHES "^#")
        continue()
    endif()
    string(REPLACE "\t" ";" f "${line}")
    list(LENGTH f n)
    if(n LESS 6)
        continue()
    endif()
    list(GET f 0 kind)
    list(GET f 2 id)
    list(GET f 3 rel)
    list(GET f 4 url)
    list(GET f 5 size)
    if(kind STREQUAL "model")
        set(dst "${OUT}/Models/${id}/${rel}")
        if(EXISTS "${dst}")
            file(SIZE "${dst}" have)
            if(have EQUAL size)
                continue()
            endif()
        endif()
        file(DOWNLOAD "${url}" "${dst}" STATUS st TLS_VERIFY ON)
        list(GET st 0 code)
        if(NOT code EQUAL 0)
            math(EXPR failed "${failed} + 1")
            file(REMOVE "${dst}")
        else()
            math(EXPR got "${got} + 1")
        endif()
    elseif(kind STREQUAL "texture")
        # the zip in the cache; only the maps the materials read kept: color, normal (OpenGL), roughness, AO
        set(done "${OUT}/Textures/${id}/.done")
        if(EXISTS "${done}")
            continue()
        endif()
        set(zip "${CACHE}/${rel}")
        set(ok TRUE)
        if(EXISTS "${zip}")
            file(SIZE "${zip}" have)
            if(NOT have EQUAL size)
                file(REMOVE "${zip}")
            endif()
        endif()
        if(NOT EXISTS "${zip}")
            file(DOWNLOAD "${url}" "${zip}" STATUS st TLS_VERIFY ON)
            list(GET st 0 code)
            if(NOT code EQUAL 0)
                set(ok FALSE)
                file(REMOVE "${zip}")
            endif()
        endif()
        if(ok)
            set(tmp "${CACHE}/x_${id}")
            file(REMOVE_RECURSE "${tmp}")
            file(ARCHIVE_EXTRACT INPUT "${zip}" DESTINATION "${tmp}")
            # (+ Opacity: the decals' and atlases' cutout, e.g. the metro's graffiti)
            file(GLOB maps "${tmp}/*_Color.jpg" "${tmp}/*_NormalGL.jpg" "${tmp}/*_Roughness.jpg" "${tmp}/*_AmbientOcclusion.jpg" "${tmp}/*_Opacity.jpg")
            file(MAKE_DIRECTORY "${OUT}/Textures/${id}")
            foreach(m IN LISTS maps)
                get_filename_component(nm "${m}" NAME)
                configure_file("${m}" "${OUT}/Textures/${id}/${nm}" COPYONLY)
            endforeach()
            file(REMOVE_RECURSE "${tmp}")
            file(WRITE "${done}" "${url}\n")
            math(EXPR got "${got} + 1")
        else()
            math(EXPR failed "${failed} + 1")
        endif()
    endif()
endforeach()
if(failed GREATER 0)
    message(WARNING "Demo assets: ${failed} downloads failed (no internet?): the demos use their simple materials until the next build")
elseif(got GREATER 0)
    message(STATUS "Demo assets: ${got} downloaded into ${OUT}")
endif()
