# (2026-11-25, item 22) A reference scene rendered and compared (the suite's render_ref_*): the engine with ARGS takes
# its --shot near the end of its --bench (its own fps limit in ARGS), then tools/compare_png.py against REF.
# cmake -DENGINE=<rivora.exe> -DPY=<python> -DSRC=<repo> -DSHOT=<png> -DREF=<png> "-DARGS=a;b;c" [-DUPDATE=1] -P ...
string(REPLACE "|" ";" ARGS "${ARGS}") # (joined by "|" in the CMakeLists: a ";" would split the add_test's argument)
file(REMOVE "${SHOT}")
get_filename_component(shot_dir "${SHOT}" DIRECTORY)
file(MAKE_DIRECTORY "${shot_dir}") # (the engine writes no folder for its --shot)
execute_process(COMMAND "${ENGINE}" ${ARGS} --shot "${SHOT}" OUTPUT_VARIABLE o ERROR_VARIABLE e RESULT_VARIABLE r TIMEOUT 300)
string(REGEX MATCHALL "[^\n]*(Measure:|FAIL|VUID|\\[Vulkan\\]|DEVICE_LOST)[^\n]*" lines "${o}${e}")
foreach(l IN LISTS lines)
    message("${l}")
endforeach()
if(NOT r EQUAL 0)
    message("FAIL: render ref: the engine ended with ${r}")
endif()
set(extra "")
if((UPDATE OR "$ENV{REALENGINE_UPDATE_REFS}" STREQUAL "1") AND NOT REF STREQUAL "-") # (tools/suite.ps1 -GravarReferencias; "-": no reference)
    set(extra "--update")
endif()
# (the viewport alone: the editor's panels, menus and status bar show fps numbers that change every run)
if(NOT CMP)
    # (limits: run to run the mean moves 0.00..0.40 on the RTX 3060; Epic against High is 1.29, so 0.8 tells them apart)
    set(CMP --crop 0.0,0.08,0.79,0.96 --max-mean 0.8 --max-bad 0.5)
endif()
# (2026-11-25) DARK: at most so many % of the view almost black (the Low preset's black house; compare_png.py --max-dark)
if(DARK)
    list(APPEND CMP --max-dark ${DARK})
endif()
execute_process(COMMAND "${PY}" "${SRC}/tools/compare_png.py" "${SHOT}" "${REF}" ${CMP} ${extra} OUTPUT_VARIABLE c ERROR_VARIABLE ce)
message("${c}${ce}")
