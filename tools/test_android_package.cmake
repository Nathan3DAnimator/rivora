# (2026-11-25, item 22) Build > Package for Android from the command line, then the APK run on a phone when one is
# plugged in (adb): installed, opened, still running 8 s later. No Android SDK: SKIP. No phone: the package alone.
# cmake -DENGINE=<rivora.exe> -DLEVEL=<.rlevel to write> -DOUT=<folder> -P tools/test_android_package.cmake
set(sdk "$ENV{ANDROID_HOME}")
if(NOT sdk)
    set(sdk "$ENV{LOCALAPPDATA}/Android/Sdk")
endif()
file(TO_CMAKE_PATH "${sdk}" sdk)
if(NOT EXISTS "${sdk}/build-tools")
    message("android_package: SKIP (no Android SDK at ${sdk})")
    return()
endif()
file(REMOVE_RECURSE "${OUT}")
get_filename_component(level_dir "${LEVEL}" DIRECTORY)
file(MAKE_DIRECTORY "${level_dir}") # (the level's folder: --save writes no folder)
execute_process(COMMAND "${ENGINE}" --save "${LEVEL}" --package-android "${OUT}" --bench 1
                OUTPUT_VARIABLE o ERROR_VARIABLE e RESULT_VARIABLE r TIMEOUT 600)
file(GLOB apks "${OUT}/*.apk")
list(LENGTH apks n)
if(NOT r EQUAL 0 OR n EQUAL 0)
    string(REGEX MATCHALL "[^\n]*(FAIL|aviso|error|erro)[^\n]*" bad "${o}${e}")
    message("FAIL: android_package: no APK in ${OUT} (exit ${r}): ${bad}")
    return()
endif()
list(GET apks 0 apk)
file(SIZE "${apk}" bytes)
math(EXPR mb "${bytes} / 1048576")
message("android_package: ${apk} (${mb} MB)")

# the phone: adb from the SDK
set(adb "${sdk}/platform-tools/adb.exe")
if(NOT EXISTS "${adb}")
    message("android_package: OK (no adb: the package alone)")
    return()
endif()
execute_process(COMMAND "${adb}" devices OUTPUT_VARIABLE devs TIMEOUT 30)
string(REGEX MATCH "\n[^\n\t]+\tdevice" dev "${devs}")
if(NOT dev)
    message("android_package: OK (no phone on adb: the package alone)")
    return()
endif()
# its package and activity, from the APK (aapt of the newest build-tools)
file(GLOB bts LIST_DIRECTORIES true "${sdk}/build-tools/*")
list(SORT bts)
list(REVERSE bts)
list(GET bts 0 bt)
execute_process(COMMAND "${bt}/aapt.exe" dump badging "${apk}" OUTPUT_VARIABLE badging TIMEOUT 60)
string(REGEX MATCH "package: name='([^']+)'" _ "${badging}")
set(pkg "${CMAKE_MATCH_1}")
string(REGEX MATCH "launchable-activity: name='([^']+)'" _ "${badging}")
set(act "${CMAKE_MATCH_1}")
if(NOT pkg OR NOT act)
    message("FAIL: android_package: aapt found no package or activity in ${apk}")
    return()
endif()
execute_process(COMMAND "${adb}" install -r "${apk}" OUTPUT_VARIABLE io ERROR_VARIABLE ie RESULT_VARIABLE ir TIMEOUT 300)
if(NOT ir EQUAL 0)
    message("FAIL: android_package: adb install: ${io}${ie}")
    return()
endif()
execute_process(COMMAND "${adb}" shell am start -n "${pkg}/${act}" OUTPUT_VARIABLE so TIMEOUT 60)
execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 8)
execute_process(COMMAND "${adb}" shell pidof "${pkg}" OUTPUT_VARIABLE pid TIMEOUT 30)
string(STRIP "${pid}" pid)
execute_process(COMMAND "${adb}" shell am force-stop "${pkg}" TIMEOUT 30)
if(pid)
    message("android_package: OK (${pkg} ran on the phone: pid ${pid})")
else()
    message("FAIL: android_package: ${pkg} was not running 8 s after it was opened")
endif()
