#version 460
// Screen space subsurface scattering (A9.3a; notas-dev/render.md "Pele"): Burley's normalized diffusion over a
// subsurface material's diffuse light, as the Unreal's Subsurface Profile. mesh.frag shades its pixels in a
// checkerboard (GI_SSS, one sample): the even ones (x + y) only its diffuse light, the odd ones the rest (specular,
// emission, the fog's light), with -(the material's slot + 1) in the alpha; the per channel scattering distances are the
// material's (e7: the Subsurface Radius times its Scale, in cm). Pass 0: each such pixel's diffuse light gathered from
// the even ones around it, importance sampled by the widest channel's profile and weighed per channel by the 3D
// distance (the depth counts: nothing bleeds across a silhouette or onto the nose behind), plus its specular (its own,
// or the mean of the odd neighbors'), into u_sss; a tile's first pixel marked when the tile holds any. Pass 1: the marked
// tiles' pixels back into the color (alpha 1), u_sss zeroed behind them; elsewhere one load per 8x8 tile.
#include "common.glsl"

layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 8, rgba16f) uniform image2D o_hdr;
layout(set = 0, binding = 21) uniform sampler2D u_depth; // (one sample, reversed Z)
layout(set = 0, binding = 79, rgba16f) uniform image2D u_sss;
// the materials' extra lobes (mat_common.glsl GpuMatExt after the 4096 GpuMaterials: 64 bytes each, then 128 a slot)
layout(buffer_reference, scalar, buffer_reference_align = 16) readonly buffer SssMatBuf { vec4 v[]; };

shared uint s_any;
shared float s_r[64], s_pdf[64]; // the samples' radii (units of the widest distance) and their density there (unit profile)

#define MAX_PX 96.0 // the profile's reach on screen at most (a face filling it: no huge loops)

float ign(vec2 px, uint frame) {
    px += float(frame & 63u) * vec2(47.0, 17.0);
    return fract(52.9829189 * fract(dot(px, vec2(0.06711056, 0.00583715))));
}
vec3 world_at(FrameBuf f, ivec2 p, vec2 size, float d) {
    vec4 w = f.tsr_inv * vec4(((vec2(p) + 0.5) / size) * 2.0 - 1.0, max(d, 1e-7), 1.0);
    return w.xyz / w.w;
}
// Burley's profile (Christensen and Burley 2015), normalized over the plane: R(r) 2 pi r integrates to 1
vec3 burley(float r, vec3 d) { return (exp(-r / d) + exp(-r / (3.0 * d))) / (8.0 * 3.14159265 * d * r); }
// its radius at the share u of the energy, in units of d (Newton on 1 - e^-x / 4 - 3 e^(-x/3) / 4 = u)
float burley_radius(float u) {
    float x = max(-3.0 * log(max((1.0 - u) / 0.75, 1e-6)), 2.0 * u);
    for (int i = 0; i < 4; i++) {
        float a = exp(-x), b = exp(-x / 3.0);
        x = max(x - (1.0 - 0.25 * a - 0.75 * b - u) / (0.25 * a + 0.25 * b), 1e-4);
    }
    return x;
}

vec3 scatter(FrameBuf f, ivec2 p, ivec2 isize, vec4 h) {
    uint slot = uint(-h.a + 0.5) - 1u;
    SssMatBuf mb = SssMatBuf(f.materials);
    uint x0 = 16384u + slot * 8u; // (4096 x 64 bytes, then 128 a slot, in vec4s)
    vec4 e7 = mb.v[x0 + 7u];
    uint q = uint(e7.w + 0.5); // the channels' share of the widest distance, 8 bits each (material_gpu.inc)
    float dmax = max(e7.z, 1e-3);
    vec3 d = max(dmax * vec3(float((q >> 16u) & 255u), float((q >> 8u) & 255u), float(q & 255u)) / 255.0, vec3(1e-3));
    bool even = ((p.x + p.y) & 1) == 0;
    // the specular: this pixel's own, or the odd neighbors' mean (the same surface: theirs is -alpha too)
    vec3 S = vec3(0.0);
    if (!even) S = h.rgb;
    else {
        float n = 0.0;
        for (int k = 0; k < 4; k++) {
            ivec2 o = p + ivec2(k == 0 ? 1 : k == 1 ? -1 : 0, k == 2 ? 1 : k == 3 ? -1 : 0);
            if (any(lessThan(o, ivec2(0))) || any(greaterThanEqual(o, isize))) continue;
            vec4 ho = imageLoad(o_hdr, o);
            if (ho.a < 0.0) S += ho.rgb, n += 1.0;
        }
        S /= max(n, 1.0);
    }
    // the diffuse light around: the even neighbors' plain mean as the fallback (and all of it under a pixel's scatter)
    vec3 Dn = even ? h.rgb : vec3(0.0);
    if (!even) {
        float n = 0.0;
        for (int k = 0; k < 4; k++) {
            ivec2 o = p + ivec2(k == 0 ? 1 : k == 1 ? -1 : 0, k == 2 ? 1 : k == 3 ? -1 : 0);
            if (any(lessThan(o, ivec2(0))) || any(greaterThanEqual(o, isize))) continue;
            vec4 ho = imageLoad(o_hdr, o);
            if (ho.a < 0.0) Dn += ho.rgb, n += 1.0;
        }
        Dn /= max(n, 1.0);
    }
    vec2 size = vec2(isize);
    float dep = texelFetch(u_depth, p, 0).r;
    if (dep <= 0.0) return Dn + S;
    vec3 P = world_at(f, p, size, dep);
    float px_cm = max(length(world_at(f, p + ivec2(1, 0), size, dep) - P), 1e-4); // (cm a pixel here: orthographic too)
    if (dmax < 0.75 * px_cm) return Dn + S;
    // the samples: radii at even shares of the widest channel's energy (up to 90% of it: s_r), turned by the golden angle
    // from a rotation per pixel and frame (TSR averages them)
    uint N = clamp(pc.pad, 4u, 64u);
    float rot = ign(vec2(p), f.frame_index) * 6.2831853;
    vec3 wsum = vec3(0.0), dsum = vec3(0.0);
    for (uint k = 0u; k < N; k++) {
        float r = s_r[k] * dmax;
        float a = rot + float(k) * 2.39996323;
        vec2 off = vec2(cos(a), sin(a)) * min(r / px_cm, MAX_PX);
        ivec2 o = ivec2(floor(vec2(p) + 0.5 + off));
        if (((o.x + o.y) & 1) != 0) o.x += off.x >= 0.0 ? 1 : -1; // (the diffuse light lives on the even pixels)
        if (any(lessThan(o, ivec2(0))) || any(greaterThanEqual(o, isize))) continue;
        vec4 ho = imageLoad(o_hdr, o);
        if (ho.a >= 0.0) continue; // (not a subsurface pixel: the profile ends at its edge)
        float od = texelFetch(u_depth, o, 0).r;
        float r3 = max(length(world_at(f, o, size, od) - P), 1e-3);
        // its weight per channel: the profile at the 3D distance over the sample's density (the widest channel's:
        // R(r; d) = R(r / d; 1) / d^2)
        vec3 w = burley(r3, d) * (dmax * dmax / s_pdf[k]);
        wsum += w;
        dsum += w * ho.rgb;
    }
    vec3 D = mix(Dn, dsum / max(wsum, vec3(1e-30)), step(vec3(1e-20), wsum));
    return D + S;
}

void main() {
    ivec2 isize = imageSize(o_hdr);
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    bool inside = all(lessThan(p, isize));
    FrameBuf f = FrameBuf(pc.frame);
    if (pc.pass == 1u) { // the marked tiles back into the color
        if (gl_LocalInvocationIndex == 0u) s_any = imageLoad(u_sss, p).a >= 1.5 ? 1u : 0u;
        barrier();
        if (s_any == 0u || !inside) return;
        vec4 s = imageLoad(u_sss, p);
        if (s.a > 0.5) {
            if (mod(s.a, 2.0) > 0.5) imageStore(o_hdr, p, vec4(min(s.rgb, vec3(60000.0)), 1.0)); // (1 or 3: a pixel of skin)
            imageStore(u_sss, p, vec4(0.0));
        }
        return;
    }
    if (gl_LocalInvocationIndex == 0u) s_any = 0u;
    barrier();
    vec4 h = inside ? imageLoad(o_hdr, p) : vec4(0.0, 0.0, 0.0, 1.0);
    bool mine = inside && h.a < 0.0;
    if (mine) s_any = 1u; // (any thread: they all write 1)
    barrier();
    if (s_any == 0u) return;
    { // (the tile holds skin: the radii once for its threads)
        uint N = clamp(pc.pad, 4u, 64u), i = gl_LocalInvocationIndex;
        if (i < N) {
            float x = max(burley_radius((float(i) + 0.5) / float(N) * 0.9), 1e-3);
            s_r[i] = x, s_pdf[i] = burley(x, vec3(1.0)).x;
        }
        barrier();
    }
    vec3 c = mine ? scatter(f, p, isize, h) : vec3(0.0);
    float a = (mine ? 1.0 : 0.0) + (gl_LocalInvocationIndex == 0u ? 2.0 : 0.0); // (the tile's first pixel: its mark)
    if (a > 0.0) imageStore(u_sss, p, vec4(c, a));
}
