        if (add != 0u) {
            // a torn stretch spring takes the bending ones through it (else the tear would hang on them)
            if ((add & 3u) != 0u) add |= 3u << 8u;
            if ((add & 12u) != 0u) add |= 3u << 10u;
            mask.v[v] = mk | add;
        }
    }
}
#endif
