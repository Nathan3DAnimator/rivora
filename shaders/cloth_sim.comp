#version 460
#ifdef SOFT_BLOCK
#extension GL_KHR_shader_subgroup_clustered : require
#endif
// Cloth (cloth.c, cloth.glsl, notas-dev/tecido.md): Vertex Block Descent (Chen, Macklin, Kim, Yuksel, SIGGRAPH 2024).
// Each vertex of a color (9 colors: a vertex's springs reach 2 cells, so (x mod 3, y mod 3) never touches another of
// its color) takes one Newton step on its own block: the inertia plus its springs' energies, their Hessians clamped to
// stay positive (no explosions at any stiffness), damping as in the paper. Contacts as in Offset Geometric Contact
// (Chen et al., SIGGRAPH 2025): a vertex never moves more than a share of its distance to the nearest collider in a step,
// so it can't tunnel; then it is pushed to the collider's offset surface (the cloth's thickness) with friction.
// pc.pass: 0 predict (gravity, wind, the pins follow the actor), 1 a color's solve (header.color), 2 velocities + tears,
// 3 a cut (every spring of the vertices inside header.cut torn), 4 the new cloths at rest, 5 the BLAS's triangles,
// 6-8 self collision (as NvCloth's, vertex against vertex): 6 the hash emptied, 7 each vertex into its cell, 8 each
// vertex's 4 nearest contacts (another cloth's, or its own past 2 grid steps) found once a substep; the solve keeps them
// apart by a stiff penalty in its Newton step; 9 a mesh's normals (its triangles around each vertex).
// A mesh (CLF_MESH): the same passes over its adjacency lists instead of the grid (cloth.glsl)
// A soft body (CLF_SOFT, softbody.h): a lattice of cubes, 6 tetrahedra each, its vertices' Newton step on stable
// Neo-Hookean elasticity (soft_solve); 8 colors ((x, y, z) mod 2: a tetrahedron never joins two of one); its contacts let
// it in by how far outside its mesh the vertex stands; the last iteration's contact forces summed per collider for the
// physics bodies (cloth.c reads them back), its dent kept and let go by its plasticity (pass 2)
#include "common.glsl"
#include "cloth.glsl"

#ifdef SOFT_BLOCK

layout(local_size_x = 512) in; // (64 vertices at once, 8 lanes each: one a cell around it)
#else
layout(local_size_x = 64) in;
#endif

ClothHeader H;
#ifdef SOFT_BLOCK
#define SB_COLS 32u
shared vec4 sbcol[3u * SB_COLS]; // (its body's colliders, the first 32)
vec4 COLV(uint k, uint first, uint j) { return sbcol[3u * (k - first) + j]; }
#else
#define SB_COLS 0xFFFFFFFFu
vec4 COLV(uint k, uint first, uint j) { return ClothVec4(H.colliders).v[3u * k + j]; }
#endif

uint self_bucket(vec3 p) {
    ivec3 q = ivec3(floor(p / H.cell));
    return uint((q.x * 73856093) ^ (q.y * 19349663) ^ (q.z * 83492791)) & (H.nbuckets - 1u);
}

vec3 qrot(vec4 q, vec3 v) { return v + 2.0 * cross(q.xyz, cross(q.xyz, v) + q.w * v); }

// The nearest collider: its signed distance (m), the way out and which one (3 vec4 a collider: a.w its type, + 16 when
// the CPU wants its contact forces back)
float collide(vec3 p, uint first, uint count, out vec3 nrm, out uint which) {
    float best = 1e9;
    nrm = vec3(0.0, 0.0, 1.0);
    which = 0xFFFFFFFFu;
    for (uint k = first; k < first + min(count, SB_COLS) && k < H.ncolliders; k++) {
        vec4 a = COLV(k, first, 0u), b = COLV(k, first, 1u);
        uint type = uint(a.w) & 15u;
        float d;
        vec3 n;
        if (type == 0u) { // sphere
            vec3 r = p - a.xyz;
            float l = length(r);
            d = l - b.w, n = l > 1e-6 ? r / l : vec3(0, 0, 1);
        } else if (type == 1u) { // capsule
            vec3 ab = b.xyz - a.xyz;
            float t = clamp(dot(p - a.xyz, ab) / max(dot(ab, ab), 1e-8), 0.0, 1.0);
            vec3 r = p - (a.xyz + ab * t);
            float l = length(r);
            d = l - b.w, n = l > 1e-6 ? r / l : vec3(0, 0, 1);
        } else if (type == 6u) { // (Q10) a moving capsule (a Physics Asset body): swept over the substeps from last frame's
            // place (the next slot) to now's; a vertex the axis passed (inside now, on the other side before) is put back
            // on the side it was on: pushed ahead of the limb, not through it
            bool prev_ok = k + 1u < first + min(count, SB_COLS) && k + 1u < H.ncolliders; // (cut off by the per-cloth limit: as it is now)
            vec4 pa = prev_ok ? COLV(k + 1u, first, 0u) : a, pb = prev_ok ? COLV(k + 1u, first, 1u) : b;
            float f = clamp((float((pc.pad >> 16) & 15u) + 1.0) / float(max((pc.pad >> 20) & 15u, 1u)), 0.0, 1.0); // (pass 1's pad: bits 16-19 the substep, 20-23 of how many)
            vec3 a0 = mix(pa.xyz, a.xyz, f), b0 = mix(pb.xyz, b.xyz, f);
            vec3 ab = b0 - a0;
            float t = clamp(dot(p - a0, ab) / max(dot(ab, ab), 1e-8), 0.0, 1.0);
            vec3 r = p - (a0 + ab * t);
            float l = length(r);
            d = l - b.w, n = l > 1e-6 ? r / l : vec3(0, 0, 1);
            if (d < 0.0) {
                vec3 pab = pb.xyz - pa.xyz;
                float tp = clamp(dot(p - pa.xyz, pab) / max(dot(pab, pab), 1e-8), 0.0, 1.0);
                vec3 rp = p - (pa.xyz + pab * tp);
                float lp = length(rp);
                if (lp > b.w * 0.5 && dot(rp, r) < 0.0) n = rp / lp, d = -(l + b.w); // (out ahead, the way it came)
            }
        } else if (type == 7u) { // (the slot before's last place: not a collider of its own)
            continue;
        } else if (type == 2u) { // box (min, max)
            vec3 q = clamp(p, a.xyz, b.xyz);
            vec3 r = p - q;
            float l = length(r);
            if (l > 1e-6) d = l, n = r / l;
            else { // inside: out through the nearest face
                vec3 lo = p - a.xyz, hi = b.xyz - p;
                vec3 m = min(lo, hi);
                if (m.x <= m.y && m.x <= m.z) d = -m.x, n = vec3(lo.x < hi.x ? -1.0 : 1.0, 0.0, 0.0);
                else if (m.y <= m.z) d = -m.y, n = vec3(0.0, lo.y < hi.y ? -1.0 : 1.0, 0.0);
                else d = -m.z, n = vec3(0.0, 0.0, lo.z < hi.z ? -1.0 : 1.0);
            }
        } else if (type == 4u) { // (Q9) an oriented box: center a, half extents b, turned by the quaternion c
            vec4 q = COLV(k, first, 2u);
            vec3 lp = qrot(vec4(-q.xyz, q.w), p - a.xyz);
            vec3 qq = clamp(lp, -b.xyz, b.xyz);
            vec3 r = lp - qq;
            float l = length(r);
            vec3 ln;
            if (l > 1e-6) d = l, ln = r / l;
            else {
                vec3 m = b.xyz - abs(lp);
                if (m.x <= m.y && m.x <= m.z) d = -m.x, ln = vec3(lp.x < 0.0 ? -1.0 : 1.0, 0.0, 0.0);
                else if (m.y <= m.z) d = -m.y, ln = vec3(0.0, lp.y < 0.0 ? -1.0 : 1.0, 0.0);
                else d = -m.z, ln = vec3(0.0, 0.0, lp.z < 0.0 ? -1.0 : 1.0);
            }
            n = qrot(q, ln);
        } else { // a floor at a.z
            d = p.z - a.z, n = vec3(0, 0, 1);
        }
        if (d < best) best = d, nrm = n, which = k;
    }
    return best;
}
float collide(vec3 p, uint first, uint count, out vec3 nrm) { uint k; return collide(p, first, count, nrm, k); }

// --- Soft bodies (CLF_SOFT) ---
const uvec4 SB_TETS[6] = uvec4[6](uvec4(0u, 1u, 3u, 7u), uvec4(0u, 1u, 5u, 7u), uvec4(0u, 2u, 3u, 7u), uvec4(0u, 2u, 6u, 7u), uvec4(0u, 4u, 5u, 7u), uvec4(0u, 4u, 6u, 7u)); // (softbody.c g_soft_tets)
// each one's order of the axes (0 -> e_a -> e_a + e_b -> 7): its rest's inverse in closed form, rows (e_a - e_b, e_b - e_c,
// e_c) / cell: no rest read, no inverse (the lattice is regular in the actor's scaled space)
const uvec3 SB_ORD[6] = uvec3[6](uvec3(0u, 1u, 2u), uvec3(0u, 2u, 1u), uvec3(1u, 0u, 2u), uvec3(1u, 2u, 0u), uvec3(2u, 0u, 1u), uvec3(2u, 1u, 0u));
vec3 sb_e(uint a) { return vec3(a == 0u ? 1.0 : 0.0, a == 1u ? 1.0 : 0.0, a == 2u ? 1.0 : 0.0); }
#define FB_SCALE 1024.0
// The lattice's positions and dents: the block pass (SOFT_BLOCK: a workgroup a soft body) keeps its body's in shared memory,
// the passes by color read the buffers
#ifdef SOFT_BLOCK
#define SB_MAX 2048u
#define SB_THREADS 512u
#define SB_SLOTS 64u
shared float sbx[SB_MAX], sby[SB_MAX], sbz[SB_MAX];
shared uint sbpa[SB_MAX], sbpb[SB_MAX]; // (the dents, half floats)
vec3 SBP(uint i, ClothInfo c) { uint l = i - c.base; return vec3(sbx[l], sby[l], sbz[l]); }
vec3 SBD(uint i, ClothInfo c) { uint l = i - c.base; return vec3(unpackHalf2x16(sbpa[l]), unpackHalf2x16(sbpb[l]).x); }
void SBW(uint i, ClothInfo c, vec3 x) { uint l = i - c.base; sbx[l] = x.x, sby[l] = x.y, sbz[l] = x.z; }
#else
vec3 SBP(uint i, ClothInfo c) { return ClothVec4(H.pos).v[i].xyz; }
vec3 SBD(uint i, ClothInfo c) { return ClothVec4(H.mnormal).v[i].xyz; }
void SBW(uint i, ClothInfo c, vec3 x) { ClothVec4(H.pos).v[i] = vec4(x, 0.0); }
#endif
// the actor's space (cm) of a world point (m): its rows are a turn and a move
vec3 sb_to_local(ClothInfo c, vec3 p) {
    vec3 d = p * 100.0 - vec3(c.rows[0].w, c.rows[1].w, c.rows[2].w);
    return vec3(dot(vec3(c.rows[0].x, c.rows[1].x, c.rows[2].x), d), dot(vec3(c.rows[0].y, c.rows[1].y, c.rows[2].y), d), dot(vec3(c.rows[0].z, c.rows[1].z, c.rows[2].z), d));
}
void fb_add(uint slot, vec3 v) {
    ClothUint fb = ClothUint(H.feedback);
    ivec3 q = ivec3(round(clamp(v * FB_SCALE, vec3(-2e9), vec3(2e9))));
    atomicAdd(fb.v[slot], uint(q.x)), atomicAdd(fb.v[slot + 1u], uint(q.y)), atomicAdd(fb.v[slot + 2u], uint(q.z));
}

// One lattice cell's tetrahedra around vertex v (its corner 7 - b in the cell, b the cell's bit): their elastic force on
// it and their Hessian (stable Neo-Hookean; the rest's inverse in closed form; the block pass runs the 8 cells in 8 lanes)
void sb_tet(uint v, ClothInfo c, ivec3 g, uint b, uint t, vec3 x, inout vec3 f, inout mat3 He) {
    float mu = c.k_stretch, la = max(c.k_shear, 1e-3), alpha = 1.0 + mu / la;
    uint sy = c.nx, sz = c.nx * uint(c.soft.x);
    float icell = 1.0 / max(c.dx, 1e-5), V = c.dx * c.dx * c.dx / 6.0;
    bool dents = c.tint.x > 0.0 || c.tint.y > 0.0;
    mat3 Rw = transpose(mat3(c.rows[0].xyz, c.rows[1].xyz, c.rows[2].xyz)); // (the actor's turn: its dents' frame)
    ivec3 c0 = g - ivec3(1) + ivec3(int(b & 1u), int((b >> 1) & 1u), int(b >> 2));
    uint corner = 7u - b;
    uint vb = c.base + uint(c0.z) * sz + uint(c0.y) * sy + uint(c0.x);
    {
    uvec4 tk = SB_TETS[t];
    int s = tk.x == corner ? 0 : tk.y == corner ? 1 : tk.z == corner ? 2 : tk.w == corner ? 3 : -1;
    if (s < 0) return;
    uvec4 id = uvec4(vb) + (tk & 1u) + ((tk >> 1u) & 1u) * sy + (tk >> 2u) * sz;
    vec3 x0 = id.x == v ? x : SBP(id.x, c), x1 = id.y == v ? x : SBP(id.y, c);
    vec3 x2 = id.z == v ? x : SBP(id.z, c), x3 = id.w == v ? x : SBP(id.w, c);
    uvec3 o = SB_ORD[t];
    vec3 r0 = (sb_e(o.x) - sb_e(o.y)) * icell, r1 = (sb_e(o.y) - sb_e(o.z)) * icell, r2 = sb_e(o.z) * icell; // (the rest inverse's rows)
    mat3 Ds = mat3(x1 - x0, x2 - x0, x3 - x0);
    if (dents) { // a dent shifts the rest: its corners' offsets (the actor's frame) taken off the edges
        vec3 p0 = SBD(id.x, c);
        Ds -= Rw * mat3(SBD(id.y, c) - p0, SBD(id.z, c) - p0, SBD(id.w, c) - p0);
    }
    mat3 F = outerProduct(Ds[0], r0) + outerProduct(Ds[1], r1) + outerProduct(Ds[2], r2);
    mat3 cof = mat3(cross(F[1], F[2]), cross(F[2], F[0]), cross(F[0], F[1])); // dJ/dF
    float J = dot(F[0], cof[0]);
    mat3 P = mu * F + la * (J - alpha) * cof; // (stable Neo-Hookean: the first Piola-Kirchhoff stress)
    vec3 d = s == 0 ? -(r0 + r1 + r2) : s == 1 ? r0 : s == 2 ? r1 : r2; // (dF/dx: the rest inverse's row of x)
    vec3 gj = cof * d;                                                     // (dJ/dx; J is affine in x: no more terms)
    f -= V * (P * d);
    He += V * (mu * dot(d, d) * mat3(1.0) + la * outerProduct(gj, gj));    // (exact and positive: no projection)
    }
}
void sb_cell(uint v, ClothInfo c, ivec3 g, uint b, vec3 x, inout vec3 f, inout mat3 He) {
    for (uint t = 0u; t < 6u; t++) sb_tet(v, c, g, b, t, x, f, He);
}
// a vertex's 24 (cell, tetrahedron) pairs: its corner 0 cell (bit 7) and corner 7 cell (bit 0) in all 6, the others in 2
const uvec2 SB_PAIRS[24] = uvec2[24](uvec2(0u, 0u), uvec2(0u, 1u), uvec2(0u, 2u), uvec2(0u, 3u), uvec2(0u, 4u), uvec2(0u, 5u),
                                     uvec2(7u, 0u), uvec2(7u, 1u), uvec2(7u, 2u), uvec2(7u, 3u), uvec2(7u, 4u), uvec2(7u, 5u),
                                     uvec2(6u, 0u), uvec2(6u, 1u), uvec2(5u, 2u), uvec2(5u, 3u), uvec2(3u, 4u), uvec2(3u, 5u),
                                     uvec2(4u, 0u), uvec2(4u, 2u), uvec2(2u, 1u), uvec2(2u, 4u), uvec2(1u, 3u), uvec2(1u, 5u));

// The rest of a lattice vertex's Newton step (VBD), its elasticity summed: inertia, damping, its hold, the others' contacts,
// the step, the colliders (OGC), its push on a physics body (the substep's last iteration)
void sb_finish(uint v, uint ci, ClothInfo c, uint cells, vec3 x, vec3 fe, mat3 He, bool last) {
    ClothVec4 pos = ClothVec4(H.pos), prev = ClothVec4(H.prev), tgt = ClothVec4(H.target);
    vec3 xp = prev.v[v].xyz, y = tgt.v[v].xyz;
    float m = c.mass * float(bitCount(cells));
    float m_h2 = m * c.inv_h * c.inv_h, mu = c.k_stretch;
    vec3 f = fe - m_h2 * (x - y);
    mat3 Hs = mat3(m_h2);
    float kd = c.damping * 0.01 * c.inv_h; // (Rayleigh: k_d / h, Damping 0.05 = k_d 5e-4 s)
    f -= kd * (He * (x - xp));
    Hs += He * (1.0 + kd);
    vec4 R = ClothVec4(H.mrest).v[v];
    if (R.w > 0.001 && c.soft.z < 0.5) { // a faded hold: a spring to its place on what holds it
        vec3 tw = cl_to_world(c, R.xyz) * 0.01;
        float ka = c.k_bend * R.w;
        f += ka * (tw - x), Hs += mat3(ka);
    }
    if (H.nbuckets != 0u && c.look.z > 0.0) { // the other soft bodies and the cloths (vertex against vertex, pass 8)
        ClothUint nb = ClothUint(H.selfnb), owner = ClothUint(H.owner);
        float kc = max(mu * c.dx, 1000.0);
        for (uint k = 0u; k < 4u; k++) {
            uint u = nb.v[v * 4u + k];
            if (u == 0xFFFFFFFFu) break;
            uint cu = owner.v[u];
            if (cu >= H.ncloth) continue;
            float D = c.look.z + ClothInfoBuf(H.info).c[cu].look.z;
            vec3 dd = x - pos.v[u].xyz;
            float len = length(dd);
            if (len >= D || len < 1e-7) continue;
            vec3 un = dd / len;
            f += kc * (D - len) * un;
            Hs += kc * outerProduct(un, un);
        }
    }
    if (abs(determinant(Hs)) < 1e-12) return;
    // what it leans on a collider with, quasi-static: its elasticity and its weight (the inertia left out: it reached the
    // physics body frames late, an impact's spike fed back made the body bounce off; cloth.c damps the body itself)
    vec3 fstat = f + m_h2 * (x - y) + m * vec3(0.0, 0.0, -9.81 * c.gravity);
    vec3 dx = inverse(Hs) * f;
    // the contact (OGC), the mesh's surface (not the lattice's) kept at the thickness
    float th = c.thickness - ClothVec2(H.muv).v[v].x;
    vec3 nrm;
    uint which;
    float dist = collide(x, c.col_first, c.col_count, nrm) - th;
    float lim = max(dist * 0.45, 0.002);
    float dl = length(dx);
    if (dist < 0.25 && dl > lim) dx *= lim / dl;
    x += dx;
    which = 0xFFFFFFFFu;
    float d2 = dist - length(dx); // (a step can't close more than its length: far from everything, no second look)
    if (d2 < 0.01) d2 = collide(x, c.col_first, c.col_count, nrm, which) - th;
    if (d2 < 0.0) {
        x -= nrm * d2;
        vec3 mv = x - xp;
        vec3 tang = mv - nrm * dot(mv, nrm);
        x -= tang * c.friction;
    }
    if (any(isnan(x)) || any(isinf(x))) x = xp;
    SBW(v, c, x);
    if (last && d2 < 0.001 && which < H.ncolliders) { // its push on a physics body (the last iteration's)
        vec4 a = ClothVec4(H.colliders).v[3u * which], b = ClothVec4(H.colliders).v[3u * which + 1u];
        if (a.w >= 16.0) {
            float push = dot(fstat, -nrm); // (along the contact's normal only: its sides' pushes cancel, nothing slides the body)
            vec3 F = -nrm * push;
            if (push > 0.0) {
                vec3 ctr = (uint(a.w) & 15u) == 2u ? 0.5 * (a.xyz + b.xyz) : a.xyz;
                fb_add(which * 8u, F);
                fb_add(which * 8u + 3u, cross(x - ctr, F));
                atomicAdd(ClothUint(H.feedback).v[which * 8u + 6u], 1u);
            }
        }
    }
}

// A lattice vertex's Newton step, its 8 cells one after the other (the passes by color)
void soft_solve(uint v, uint ci, ClothInfo c, ivec3 g, uint cells, bool last) {
    vec3 x = SBP(v, c), f = vec3(0.0);
    mat3 He = mat3(0.0);
    for (uint b = 0u; b < 8u; b++)
        if ((cells & (1u << b)) != 0u) sb_cell(v, c, g, b, x, f, He);
    sb_finish(v, ci, c, cells, x, f, He, last);
}

void soft_post(uint v, uint ci, ClothInfo c, bool lastsub);
// The other passes of a soft body's vertex: 0 predict, 2 velocities and the dent, 4 the rest pose
void soft_pass(uint v, uint ci, ClothInfo c, uint cells, bool pinned) {
    ClothVec4 pos = ClothVec4(H.pos), prev = ClothVec4(H.prev), vel = ClothVec4(H.vel), tgt = ClothVec4(H.target);
    vec4 R = ClothVec4(H.mrest).v[v];
    float h = 1.0 / c.inv_h;
    if (pc.pass == 4u) {
        if ((c.flags & 32u) == 0u) return;
        vec3 w = cl_to_world(c, R.xyz) * 0.01;
        pos.v[v] = vec4(w, 0.0), prev.v[v] = vec4(w, 0.0), vel.v[v] = vec4(0.0), tgt.v[v] = vec4(w, 0.0);
        ClothUint(H.mask).v[v] = 0u, ClothVec4(H.mnormal).v[v] = vec4(0.0);
        return;
    }
    if (cells == 0u || c.soft.y > 0.5) return; // (empty, or asleep: still where it is)
    if (pc.pass == 0u) {
        if (pinned) {
            vec3 w = cl_to_world(c, R.xyz) * 0.01;
            pos.v[v] = vec4(w, 0.0), prev.v[v] = vec4(w, 0.0), vel.v[v] = vec4(0.0), tgt.v[v] = vec4(w, 0.0);
            return;
        }
        vec3 x = pos.v[v].xyz, u = vel.v[v].xyz;
        if (pc.pad == 0u && H.kick.w > 0.0 && (H.kick_vel.w < 0.0 || uint(H.kick_vel.w) == ci)) { // Add Soft Body Impulse
            float d = length(x - H.kick.xyz);
            if (d < H.kick.w) u += H.kick_vel.xyz * (1.0 - d / H.kick.w);
        }
        prev.v[v] = vec4(x, 0.0);
        vec3 y = x + h * u + h * h * vec3(0.0, 0.0, -9.81 * c.gravity);
        tgt.v[v] = vec4(y, 0.0), pos.v[v] = vec4(y, 0.0);
        return;
    }
    if (pc.pass == 2u && !pinned && (c.flags & CLF_BLOCK) == 0u) soft_post(v, ci, c, pc.pad == 1u); // (a block's: its own pass)
}

// After a substep (pass 2, or the block pass): the velocity, the dent, the feedback (the last substep)
void soft_post(uint v, uint ci, ClothInfo c, bool lastsub) {
    ClothVec4 pos = ClothVec4(H.pos), prev = ClothVec4(H.prev), vel = ClothVec4(H.vel);
    vec4 R = ClothVec4(H.mrest).v[v];
    float h = 1.0 / c.inv_h;
    vec3 x = pos.v[v].xyz;
    vec3 u = (x - prev.v[v].xyz) * c.inv_h * 0.998;
    float sp = length(u);
    if (sp > 40.0) u *= 40.0 / sp, sp = 40.0; // (never faster than 40 m/s: a crushing hit can't fling it away)
    vel.v[v] = vec4(u, 0.0);
    if (c.tint.x > 0.0 || c.tint.y > 0.0) { // plasticity: the rest follows a dent past the yield, and comes back slowly
        vec3 disp = (sb_to_local(c, x) - R.xyz) * 0.01;
        vec3 p = ClothVec4(H.mnormal).v[v].xyz;
        vec3 e = disp - p;
        float el = length(e);
        if (el > c.soft.w && c.tint.x > 0.0) p += e * (1.0 - c.soft.w / el) * min(c.tint.x * h, 1.0);
        p *= max(0.0, 1.0 - c.tint.y * h);
