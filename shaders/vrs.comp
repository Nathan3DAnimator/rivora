#version 460
// Variable rate shading's rate image (A9.7b; notas-dev/render.md "VRS"): before the main pass, one texel per tile of the
// render (vk->vrs_texel px, 16 on NVIDIA), from last frame's color at the same place (the HDR the composite read): a flat
// tile (little contrast) shaded once per 2x2 pixels, one that changes only across x or y at 2x1 / 1x2, the rest at
// every pixel. Only the opaque meshes take it (their pipelines' combiner); the sky, particles, water keep full rate.
// The values: VK_KHR_fragment_shading_rate's (log2 width << 2 | log2 height).
#include "common.glsl"

layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 1) uniform sampler2D u_prev;              // last frame's color (the output's size)
layout(set = 0, binding = 67, r8ui) uniform uimage2D o_rate;          // (read too: last frame's rate, the hysteresis)
layout(set = 0, binding = 21) uniform sampler2D u_depth;            // this frame's prepass depth (pc.pass & 1: there is one)

float tone(vec3 c) { float l = dot(c, vec3(0.2126, 0.7152, 0.0722)); return l / (1.0 + l); }

// (2026-11-14, "Sombreamento de taxa variável cria artefatos") three fixes over the first version:
//  - a tile crossing a depth edge (this frame's prepass) stays 1x1: a coarse pixel there shaded past the triangle's edge
//    (light through thin walls, the edges' halos);
//  - last frame's color read where this point was last frame (the depth back to the world, last frame's view): moving
//    things got the rate of what was there before them, a frame late;
//  - hysteresis: a tile turns coarse only well inside the thresholds and back to full rate only well past them (last
//    frame's rate read back): the rates flipped frame to frame on the noise, the coarse pixels shimmered
void main() {
    ivec2 t = ivec2(gl_GlobalInvocationID.xy);
    ivec2 n = imageSize(o_rate);
    if (t.x >= n.x || t.y >= n.y) return;
    FrameBuf f = FrameBuf(pc.frame);
    float T = float(pc.pad);                 // the tile's side in render pixels
#ifdef RE_VRS_FOVEATED
    { // (Q25) VR's fixed foveated rendering: rings around the eye's center (the lens's sharp middle),
        // level 1..3 (Low / Medium / High): 1x1 inside, then 2x1 / 1x2 along the ring, then 2x2. The radius in the view's
        // height (an eye's image is about square), the rings tighter as the level rises. Coarser than 2x2 never: with MSAA 4x
        // the GPU can't take 4x4, and the lens's edge is still seen at 2x2 (the Quest's own FFR: 1/4 at the far edge)
        uint level = pc.pass >> 8;
        vec2 c = (vec2(t) + 0.5) * T * f.viewport.zw - 0.5;          // -0.5..0.5 across the view
        c.x *= float(n.x) / float(n.y);                             // (the aspect: the rings round)
        float r = length(c) * 2.0;                                  // 0 the center, 1 the middle of an edge
        float r1 = level >= 3u ? 0.42 : level == 2u ? 0.55 : 0.70; // full rate inside
        float r2 = level >= 3u ? 0.62 : level == 2u ? 0.78 : 0.95; // 2x2 outside
        uint rate = 0u;
        if (r > r2) rate = 5u;
        else if (r > r1) rate = abs(c.x) > abs(c.y) ? 1u : 4u;    // (the ring: coarser along it, the radial detail kept)
        imageStore(o_rate, t, uvec4(rate));
        return;
    }
#else
    vec2 inv = f.viewport.zw;                // 1 / the render's size
    bool depth = (pc.pass & 1u) != 0u;
    float lo = 1e9, hi = 0.0, gx = 0.0, gy = 0.0, zlo = 1e9, zhi = 0.0;
    float row[4], prev[4];
    for (int j = 0; j < 4; j++) {
        for (int i = 0; i < 4; i++) {
            vec2 px = vec2(t) * T + (vec2(i, j) + 0.5) * (T * 0.25);
            vec2 uv = px * inv;
            if (depth) {
                float z = textureLod(u_depth, uv, 0.0).r;
                zlo = min(zlo, z), zhi = max(zhi, z);
                if (z > 0.0) { // (reprojected: where this point was in last frame's image)
                    vec4 w = f.tsr_inv * vec4(uv * 2.0 - 1.0, z, 1.0);
                    vec4 p = f.tsr_prev_vp * vec4(w.xyz / w.w, 1.0);
                    if (p.w > 1e-4) {
                        vec2 q = p.xy / p.w * 0.5 + 0.5;
                        if (all(greaterThanEqual(q, vec2(0.0))) && all(lessThanEqual(q, vec2(1.0)))) uv = q;
                    }
                }
            }
            float l = tone(textureLod(u_prev, uv, 0.0).rgb);
            lo = min(lo, l), hi = max(hi, l);
            row[i] = l;
            if (i > 0) gx += abs(l - row[i - 1]);
            if (j > 0) gy += abs(l - prev[i]);
        }
        for (int i = 0; i < 4; i++) prev[i] = row[i];
    }
    uint was = imageLoad(o_rate, t).r;
    // hysteresis: from full rate the thresholds are 30% tighter, from a coarse rate 30% looser
    // (the thresholds a third of the first version's, 0.035 and 0.09: a fine texture shaded 2x2 sampled other texels
    // with every jitter, house 0.35% of the view flickering against 0.17% without VRS; now 0.19%, the pass still 30% less)
    float k = was == 0u ? 0.7 : 1.3;
    float contrast = hi - lo;
    uint rate = 0u; // 1x1
    if (contrast < 0.0105 * k) rate = 5u;                    // 2x2: flat
    else if (contrast < 0.027 * k) {
        if (gx < gy * 0.4) rate = 4u;                        // 2x1: it changes down the tile, not across it
        else if (gy < gx * 0.4) rate = 1u;                   // 1x2: across, not down
    }
    // a depth edge in the tile (the reversed depth's relative spread: another surface, or the sky): full rate
    if (depth && rate != 0u && (zlo <= 0.0 ? zhi > 0.0 : (zhi - zlo) > 0.03 * zhi)) rate = 0u;
    imageStore(o_rate, t, uvec4(rate));
#endif
}
