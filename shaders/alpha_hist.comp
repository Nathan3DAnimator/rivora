#version 460
// A Masked material's baked alpha kept at mip 0's coverage in every mip (material.c alpha_coverage_mips; the "alpha test
// coverage" of NVTT, Castano 2010): the linear blits average the alpha and a card's thin strands fall under the clip value
// mip after mip (hair and leaves thin out, then vanish, with the distance and in the shadows' coarser reads).
// mode 0: one mip's 256-bin alpha histogram; mode 1: that mip's alpha times the scale that brings its coverage back.
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_buffer_reference_uvec2 : require

layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0, rgba8) uniform image2D u_mip; // the mip (its own view)
layout(push_constant, scalar) uniform HistPush { uvec2 out_addr; uint mode, level, w, h; float scale; } pc;
layout(buffer_reference, scalar, buffer_reference_align = 4) buffer HistBuf { uint v[]; };

shared uint s_h[256];

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    bool in_mip = p.x < int(pc.w) && p.y < int(pc.h);
    if (pc.mode == 1u) {
        if (!in_mip) return;
        vec4 c = imageLoad(u_mip, p);
        imageStore(u_mip, p, vec4(c.rgb, min(c.a * pc.scale, 1.0)));
        return;
    }
    uint t = gl_LocalInvocationIndex;
    for (uint k = t; k < 256u; k += 64u) s_h[k] = 0u;
    barrier();
    if (in_mip) atomicAdd(s_h[min(uint(imageLoad(u_mip, p).a * 255.0 + 0.5), 255u)], 1u);
    barrier();
    HistBuf hb = HistBuf(pc.out_addr);
    for (uint k = t; k < 256u; k += 64u)
        if (s_h[k] != 0u) atomicAdd(hb.v[pc.level * 256u + k], s_h[k]);
}
