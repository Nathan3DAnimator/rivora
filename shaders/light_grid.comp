#version 460
// The world light grid (lights.glsl, lights.c, notas-dev/luz.md), rebuilt every frame from every local light on the
// GPU. pc.pass 0: each light counts itself in the cells its sphere reaches; 1: each cell gets its range of the items
// (one global atomic per workgroup; past the capacity a cell keeps what fits); 2: each light writes itself there.
// A light goes in its home level and in the coarser ones while its range is at least lg_params.y of their cell (the
// light's LOD: a small light far away lights nothing worth a 64 m cell); there, the cells inside the finer level are
// skipped for it (the finer level answers for them).
#extension GL_KHR_shader_subgroup_ballot : require
#extension GL_KHR_shader_subgroup_shuffle : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#include "common.glsl"
#include "lights.glsl"

layout(local_size_x = 64) in;

shared uint s_sum, s_base;

void main() {
    FrameBuf f = FrameBuf(pc.frame);
    CellBuf cells = CellBuf(f.lg_cells);
    UintBuf cursor = UintBuf(f.lg_cursor); // per cell, then the items asked for (all cells) at the end
    uint i = gl_GlobalInvocationID.x;
    if (pc.pass == 1u) { // every cell (a multiple of 64: the barriers see every thread)
        uint cnt = cells.c[i].y;
        if (gl_LocalInvocationIndex == 0u) s_sum = 0u;
        barrier();
        uint local = atomicAdd(s_sum, cnt);
        barrier();
        if (gl_LocalInvocationIndex == 0u) s_base = atomicAdd(cursor.v[LG_LEVELS * LG_LEVEL_CELLS], s_sum);
        barrier();
        uint off = s_base + local, cap = f.lg_cap;
        cells.c[i] = uvec2(off, off >= cap ? 0u : min(cnt, cap - off));
        cursor.v[i] = off;
        return;
    }
    // passes 0 and 2: a light per thread; its cells shared by the whole subgroup, one light after another (a light
    // near the camera reaches up to 17^3 cells of 4 m: alone, its thread kept the other 31 waiting)
    uint slots = uint(f.lg_params.w);
    GpuLight Lt;
    bool valid = i < slots;
    if (valid) {
        Lt = LightBuf(f.light_buf).l[i];
        valid = Lt.type != 0xFFFFFFFFu;
    }
    float r = valid ? light_reach(Lt) : 0.0;
    // a light that can't reach the view nor what lights it (the GI's range around the camera) stays out of the grid
    if (valid && length(Lt.position - f.camera_pos.xyz) - r > f.gi_range) {
        for (int p = 0; p < 6 && valid; p++) valid = dot(f.cull_planes[p].xyz, Lt.position) + f.cull_planes[p].w >= -r;
        if (!valid) r = 0.0;
    }
    vec3 lpos = valid ? Lt.position : vec3(0.0);
    uint home = valid ? lg_home(f, r) : 0u;
    UintBuf items = UintBuf(f.lg_items);
    for (uint L = 0u; L < LG_LEVELS; L++) {
        float cs = lg_cell_size(f, L);
        ivec3 o = f.lg_origin[L].xyz;
        ivec3 lo = max(ivec3(floor((lpos - r) / cs)) - o, ivec3(0));
        ivec3 hi = min(ivec3(floor((lpos + r) / cs)) - o, ivec3(LG_DIM_XY - 1, LG_DIM_XY - 1, LG_DIM_Z - 1));
        // in its home level, and in a coarser one while its range is worth a cell there
        bool job = valid && L >= home && (L == home || r >= cs * f.lg_params.y) && all(lessThanEqual(lo, hi));
        bool skip_inner = L > home;
        vec3 fmn = vec3(0.0), fmx = vec3(0.0);
        if (L > 0u) {
            float fc = lg_cell_size(f, L - 1u);
            fmn = vec3(f.lg_origin[L - 1u].xyz) * fc;
            fmx = fmn + vec3(LG_DIM_XY, LG_DIM_XY, LG_DIM_Z) * fc;
        }
        // the levels lights call home (lights.glsl skips the others' lookups): one atomic per subgroup
        uint homes = subgroupOr(job && L == home ? 1u << home : 0u);
        if (pc.pass == 0u && homes != 0u && subgroupElect()) atomicOr(cursor.v[LG_LEVELS * LG_LEVEL_CELLS + 1u], homes);
        uvec4 todo = subgroupBallot(job);
        while (subgroupBallotBitCount(todo) > 0u) {
            uint lane = subgroupBallotFindLSB(todo);
            todo[lane >> 5] &= ~(1u << (lane & 31u));
            vec3 p = subgroupShuffle(lpos, lane);
            float rr = subgroupShuffle(r, lane);
            ivec3 l0 = subgroupShuffle(lo, lane), l1 = subgroupShuffle(hi, lane);
            uint item = subgroupShuffle(i | (home << 30), lane);
            bool inner = subgroupShuffle(skip_inner, lane);
            ivec3 ext = l1 - l0 + 1;
            uint n = uint(ext.x * ext.y * ext.z);
            for (uint c = gl_SubgroupInvocationID; c < n; c += gl_SubgroupSize) {
                ivec3 xyz = l0 + ivec3(int(c) % ext.x, (int(c) / ext.x) % ext.y, int(c) / (ext.x * ext.y));
                vec3 cmn = vec3(o + xyz) * cs, cmx = cmn + cs;
                if (inner && all(greaterThanEqual(cmn, fmn)) && all(lessThanEqual(cmx, fmx))) continue;
                vec3 q = clamp(p, cmn, cmx) - p;
                if (dot(q, q) > rr * rr) continue; // the box's corner the sphere misses
                uint cell = L * LG_LEVEL_CELLS + uint((xyz.z * LG_DIM_XY + xyz.y) * LG_DIM_XY + xyz.x);
                if (pc.pass == 0u) {
                    atomicAdd(UintBuf(f.lg_cells).v[cell * 2u + 1u], 1u); // the cell's count
                } else {
                    uint at = atomicAdd(cursor.v[cell], 1u);
                    uvec2 oc = cells.c[cell];
                    if (at < oc.x + oc.y) items.v[at] = item;
                }
            }
        }
    }
}
